{
  "name": "lingbot-browser",
  "description": "小灵 LingBot - AI 语音浏览器助手 | AI Voice Browser Assistant",
  "private": true,
  "version": "1.8.3",
  "type": "module",
  "author": {
    "name": "zw123zw",
    "url": "https://github.com/zw123zw",
    "email": "xiaoling6668882026@outlook.com"
  },
  "license": "MIT",
  "homepage": "https://github.com/zw123zw/ai-browser#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zw123zw/ai-browser.git"
  },
  "bugs": {
    "url": "https://github.com/zw123zw/ai-browser/issues"
  },
  "keywords": [
    "browser-extension",
    "chrome-extension",
    "ai",
    "voice",
    "automation",
    "wxt",
    "vue3",
    "manifest-v3"
  ],
  "scripts": {
    "dev": "bash -c \"cp docs/site/guide-zh.md public/guide-zh.md && cp docs/site/guide-en.md public/guide-en.md && wxt\"",
    "build": "bash -c \"D=$(date +%Y%m%d-%H%M%S) && cp docs/site/guide-zh.md public/guide-zh.md && cp docs/site/guide-en.md public/guide-en.md && bash scripts/build-check.sh && rm -rf .output && wxt build && mv .output/chrome-mv3 .output/ai-browser-prod-$D && cross-env VITE_LOG_ENABLED=true wxt build && mv .output/chrome-mv3 .output/ai-browser-test-$D\"",
    "build:store": "bash scripts/build-store.sh",
    "compile": "vue-tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "postinstall": "wxt prepare",
    "download-model": "bash scripts/download-model.sh"
  },
  "dependencies": {
    "@tesseract.js-data/chi_sim": "^1.0.0",
    "@tesseract.js-data/eng": "^1.0.0",
    "docx": "^9.7.1",
    "dompurify": "^3.4.11",
    "echarts": "^6.1.0",
    "highlight.js": "^11.10.0",
    "html2canvas-pro": "^2.0.4",
    "jspdf": "^4.2.1",
    "jszip": "^3.10.1",
    "katex": "^0.16.11",
    "mammoth": "^1.12.0",
    "markdown-it": "^14.1.0",
    "markdown-it-katex": "^2.0.3",
    "pdfjs-dist": "^6.0.227",
    "pinia": "^2.3.0",
    "sherpa-onnx": "^1.13.2",
    "tesseract.js": "^7.0.0",
    "uuid": "^11.0.3",
    "vue": "^3.5.13",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/dompurify": "^3.0.5",
    "@types/katex": "^0.16.7",
    "@types/markdown-it": "^14.1.2",
    "@types/uuid": "^10.0.0",
    "@vitest/coverage-v8": "^4.1.9",
    "@wxt-dev/module-vue": "^1.0.2",
    "cross-env": "^10.1.0",
    "happy-dom": "^20.10.6",
    "javascript-obfuscator": "^4.1.1",
    "sharp": "^0.35.1",
    "typescript": "^5.7.2",
    "vitest": "^4.1.9",
    "vue-tsc": "^2.1.10",
    "wxt": "^0.19.21"
  }
}
