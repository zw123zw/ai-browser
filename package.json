{
  "name": "ai-voice-browser-assistant",
  "description": "AI 语音浏览器助手 - 支持语音控制 + 网页自动化 + 多模型切换",
  "private": true,
  "version": "0.1.1",
  "type": "module",
  "author": {
    "name": "zwf1110",
    "url": "https://github.com/zwf1110"
  },
  "license": "MIT",
  "homepage": "https://github.com/zwf1110/browser-ai-chat#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zwf1110/browser-ai-chat.git"
  },
  "bugs": {
    "url": "https://github.com/zwf1110/browser-ai-chat/issues"
  },
  "keywords": [
    "browser-extension",
    "chrome-extension",
    "ai",
    "voice",
    "automation",
    "wxt",
    "vue3",
    "manifest-v3"
  ],
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox",
