    "mammoth": "^1.12.0",
    "markdown-it": "^14.1.0",
    "markdown-it-katex": "^2.0.3",
    "pdfjs-dist": "^6.0.227",
    "pinia": "^2.3.0",
    "sherpa-onnx": "^1.13.2",
    "tesseract.js": "^7.0.0",
    "uuid": "^11.0.3",
    "vue": "^3.5.13",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/katex": "^0.16.7",
    "@types/markdown-it": "^14.1.2",
    "@types/uuid": "^10.0.0",
